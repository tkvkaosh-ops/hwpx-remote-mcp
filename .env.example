MCP_TRANSPORT=streamable-http
MCP_HOST=0.0.0.0
MCP_PORT=8000
MCP_PATH=/mcp
MCP_STATELESS=true
MCP_JSON_RESPONSE=true
PUBLIC_BASE_URL=https://your-service.example.com
HWPX_OUTPUT_DIR=/app/output
HWPX_DOWNLOAD_TTL_SECONDS=86400
HWPX_MAX_UPLOAD_BYTES=20971520
HWPX_MAX_UNCOMPRESSED_BYTES=104857600
DOWNLOAD_SIGNING_KEY=replace-with-a-long-random-secret
